# ===== 模型配置（必填其一）=====
# DeepSeek 开放平台申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# 兼容任何 OpenAI 协议的服务；换成其他厂商时同时改 LLM_MODEL
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 单次模型请求超时（秒）
LLM_TIMEOUT=60

# 工具调用最大轮次，防止模型反复调工具陷入死循环
MAX_TOOL_ROUNDS=4

# ===== 演示模式（没有 Key 时可用）=====
# 1 = 使用本地桩模型，只验证前后端链路，不做真实推理
LLM_MOCK=0

# ===== 数据与检索 =====
DB_PATH=data/history.db
CHART_DIR=data/charts
KNOWLEDGE_DIR=knowledge
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=1.2
